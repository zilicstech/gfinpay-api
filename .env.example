# Copy to .env and fill secrets. Never commit .env.
# On App Platform, set the same names as encrypted environment variables.
# Managed Postgres URL must use the JDBC scheme and sslmode, for example:
# jdbc:postgresql://HOST:25060/DATABASE?sslmode=require

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fintech
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

APP_JWT_SECRET=

# Session security. Access tokens are short-lived and refreshed from an httpOnly cookie.
APP_AUTH_ACCESS_TOKEN_MINUTES=30
APP_AUTH_IDLE_MINUTES=30
APP_AUTH_SESSION_ABSOLUTE_HOURS=12
APP_AUTH_COOKIE_NAME=gfp_rt
# Leave blank for host-only. Set to the shared parent domain (e.g. .gfinpay.com) in deployed envs.
APP_AUTH_COOKIE_DOMAIN=
# Must be true when served over HTTPS.
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_COOKIE_PATH=/api/v1/auth

APP_WEBHOOK_SECRET=
# Used for minted /apply, /v, and /a links. With spring profile `local`, application-local.yml also forces these.
APP_SELF_BASE_URL=http://localhost:8090
APP_PUBLIC_APP_URL=http://localhost:3001

APP_CORS_ALLOW_ALL_ORIGINS=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3001

BOOTSTRAP_ADMIN_CODE=GFINADMIN0
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MOBILE=0000000000
BOOTSTRAP_ADMIN_EMAIL=admin@gfinpay.com

APP_PAYSPRINT_BASE_URL=https://sit.paysprint.in/service-api/api/v1/service
APP_PAYSPRINT_PARTNER_ID=PS002272
PAYSPRINT_MERCHANT_CODE=PS002272
PAYSPRINT_JWT_KEY=
PAYSPRINT_AUTHORISED_KEY=
PAYSPRINT_AES_KEY=
PAYSPRINT_AES_IV=
PAYSPRINT_WADH_BANK2=18f4CEiXeXcfGXvgWA/blxD+w2pw7hfQPY45JMytkPw=
PAYSPRINT_WADH_BANK6=E0jzJ/P8UopUHAieZn8CKqS4WPMi5ZSYXgfnlfkWjrc=
PAYSPRINT_RD_ENV=P
PAYSPRINT_IS_CASA=1
PAYSPRINT_ALLOW_PASTED_PID=true
PAYSPRINT_FD_CARD_TYPE=1
PAYSPRINT_CALLBACK_SECRET=

# KBill BBPS — UAT now; swap URL + token for production later
APP_KBILL_BASE_URL=https://development.kbillpay.com/api/kbill/v3/customer/bbps
APP_KBILL_API_TOKEN=

# DigitalOcean Spaces (S3-compatible). Never commit real keys.
APP_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
APP_SPACES_REGION=sgp1
APP_SPACES_BUCKET=gfinpay
APP_SPACES_PREFIX=dev
APP_SPACES_ACCESS_KEY=
APP_SPACES_SECRET_KEY=
